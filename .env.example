# 复制本文件为 .env 后填写（.env 已在 .gitignore 中，不会被提交）

# 中转站提供的 API Key
OPENAI_API_KEY=

# 中转站地址，一般以 /v1 结尾，例如：https://your-relay.example.com/v1
OPENAI_BASE_URL=

# 模型名，需选择支持 function calling（工具调用）的模型
MODEL_NAME=

# agent 循环的最大步数（防止无限循环）
MAX_STEPS=10

# 可选：推理强度 none / low / medium / high，留空则不发送。
# 部分推理模型（如 gpt-6-luna）在 chat/completions 接口下要设为 none 才能调用工具
REASONING_EFFORT=
